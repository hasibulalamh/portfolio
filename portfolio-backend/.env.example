APP_NAME="Portfolio CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Frontend origins allowed to call this API (see config/cors.php).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:8000

# Minutes an admin API token stays valid. Default 7 days; blank/0 falls back
# to 10080. Expired tokens are pruned at login (AuthService::pruneTokens).
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Delivery goes through Resend (https://resend.com). Get a key from
# resend.com/api-keys — it is a live credential, so keep the real value out of
# version control. Verify with: php artisan mail:test-resend you@example.com
#
# A new Resend account only delivers to the address that owns the account, and
# only from onboarding@resend.dev. To reach real visitors, verify a domain at
# resend.com/domains and point MAIL_FROM_ADDRESS at it. See BACKEND-SETUP.md.
#
# Use MAIL_MAILER=log to render emails into storage/logs/laravel.log instead of
# sending them.
MAIL_MAILER=resend
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="Hasibul Alam"

# Recipient for "new contact message / meeting request" notifications. Leave
# empty to use contact_info.email from the database, which is the normal
# production setup. Set it only to work around the sandbox limit above.
ADMIN_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage) — used by POST /admin/upload
# ---------------------------------------------------------------------------
# Find these in the Cloudflare dashboard under R2 > Manage R2 API Tokens.
#   R2_ENDPOINT — https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   R2_URL      — the bucket's public URL (custom domain or r2.dev subdomain)
# While these are blank, uploads fall back to the local `public` disk so the
# upload endpoint still works in development.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=portfolio-backend
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_URL=https://your-public-bucket-domain.example.com
# R2 has no regions; the S3 driver still wants a value and defaults to "auto".
# Only set this if a provider you point R2_ENDPOINT at needs a real region.
# R2_REGION=auto
